# Meta Messenger Configuration
META_VERIFY_TOKEN=your_meta_verify_token_here
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_APP_SECRET=your_meta_app_secret_here
META_API_VERSION=v21.0

# Groq LLM Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_MAIN=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
DAILY_TOKEN_BUDGET_MAIN=100000
DAILY_TOKEN_BUDGET_FAST=500000

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/messenger_bot

# Memory & Embedding Configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Logging & System
LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh
